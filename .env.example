# ---- both modes ----
# local | remote
DEVPILOT_MODE=local
# Fine-grained PAT. For the hosted deployment: read-only, public repositories only.
GITHUB_TOKEN=
TEST_TIMEOUT_MS=120000
# Cap on any tool's text response.
MAX_OUTPUT_CHARS=20000
# debug | info | warn | error (logs always go to stderr)
LOG_LEVEL=info

# ---- local mode ----
# Repo to operate on (default: the current directory).
WORKSPACE_ROOT=
# Optional: override the auto-detected test command, e.g. "npx vitest run --reporter=json"
TEST_COMMAND=

# ---- remote mode ----
# Comma-separated owner/repo@ref allowlist.
ALLOWED_REPOS=Ashbruh22/devpilot-demo@main
# JSON map repo -> fixed test command (never taken from tool input).
TEST_COMMANDS={"Ashbruh22/devpilot-demo":"npx --no vitest run --reporter=json"}
# Optional bearer token for /mcp. Unset = public read-only demo.
DEVPILOT_API_KEY=
PORT=3000
# Host-header allowlist for public binds (Render's RENDER_EXTERNAL_HOSTNAME is used automatically).
ALLOWED_HOSTS=
RATE_LIMIT_PER_MIN=60
WORKSPACES_DIR=/tmp/workspaces
# Run `npm ci --ignore-scripts` / `pip install` in cloned repos at boot.
INSTALL_DEPS=true
